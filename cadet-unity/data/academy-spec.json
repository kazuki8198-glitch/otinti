at":664,"from":261,"to":263.6,"label_ja":""},{"id":"d-dispatch","rooms":["dispatch","lobby"],"kind":"double_swing","wall":"a","at":664,"from":257.4,"to":259.2,"label_ja":"運航管理"},{"id":"d-dispatch-c","rooms":["dispatch","corridor-n"],"kind":"swing","wall":"c","at":261,"from":674.4,"to":675.4,"label_ja":"運航管理"},{"id":"d-pilot","rooms":["pilot","corridor-n"],"kind":"double_swing","wall":"c","at":261,"from":678.6,"to":680.4,"label_ja":"パイロットルーム"},{"id":"d-lounge","rooms":["lounge","corridor-n"],"kind":"double_swing","wall":"c","at":261,"from":690,"to":691.8,"label_ja":"訓練生ラウンジ"},{"id":"d-instructors","rooms":["instructors","corridor-n"],"kind":"swing","wall":"c","at":263.6,"from":666.4,"to":667.4,"label_ja":"教官室"},{"id":"d-planning","rooms":["planning","corridor-n"],"kind":"swing","wall":"c","at":263.6,"from":690.4,"to":691.4,"label_ja":"計画室"},{"id":"d-class2","rooms":["class2","corridor2-s"],"kind":"double_swing","wall":"c","at":261,"from":619.2,"to":621,"y":4.22,"label_ja":"大教室"},{"id":"d-library","rooms":["library","corridor2-s"],"kind":"double_swing","wall":"c","at":263.6,"from":617.2,"to":619,"y":4.22,"label_ja":"図書・自習室"},{"id":"d-av","rooms":["av","corridor2-s"],"kind":"swing","wall":"c","at":263.6,"from":632.6,"to":633.6,"y":4.22,"label_ja":"教材・視聴覚室"},{"id":"d-stairs2","rooms":["stairs2","corridor2-s"],"kind":"swing","wall":"c","at":263.6,"from":642,"to":643.2,"y":4.22,"label_ja":"階段室（2 階）"},{"id":"stair-up","rooms":["stairs","stairs2"],"kind":"opening","wall":"a","at":646,"from":264,"to":266.4,"graph":true,"label_ja":"階段"},{"id":"d-roof","rooms":["stairs2","roof"],"kind":"swing","wall":"c","at":268,"from":645,"to":646,"y":8.27,"bulkhead":true,"label_ja":"屋上"},{"id":"x-airside","rooms":["lobby","outside"],"kind":"sliding_auto","wall":"c","at":249,"from":653,"to":657,"label_ja":"エプロン（駐機場）へ"},{"id":"x-main","rooms":["lobby","outside"],"kind":"sliding_auto","wall":"c","at":277.6,"from":653,"to":657,"label_ja":"正面入口（駐車場）"}],"interactables":[{"id":"wb-brief-1","room":"brief-1","a":633.7,"c":254.6,"y":1.5,"prompt_ja":"ホワイトボードを見る","title_ja":"本日：a2 直線水平飛行（t1 → a2 → t3）","text_ja":"目的：高度・針路・速度を同時に保つ\n今日の流れ：外部点検 → エンジン始動 → ATIS・地上管制 → タキシー → ランナップ → t1 通常離陸と上昇 → 訓練空域で a2 → 帰投・t3 通常着陸 → 駐機・講評\n基準：高度 ±100 ft・針路 ±10°・速度 ±10 kt を連続 20 秒（自家用 ACS の水平直線飛行の許容幅を参考）\n天気：風 010° 5 kt・視程 10 SM 以上・高度計 29.92（架空）"},{"id":"model-archer","room":"brief-1","a":644.8,"c":250,"y":1.2,"prompt_ja":"模型を見る","title_ja":"Piper PA-28-181 Archer（訓練の単発機）","text_ja":"低翼・単発・固定脚の 4 人乗り。G1000 型の画面で飛ぶ。\n離陸の速度 Vr 60 kt、上昇 Vy 76 kt・Vx 64 kt、進入 70 kt、最良滑空 76 kt。\n（訓練用の目安の値です。実機はその機体の POH に従います）"},{"id":"wb-brief-2","room":"brief-2","a":621.1,"c":254.6,"y":1.5,"prompt_ja":"ホワイトボードを見る","title_ja":"復習：t1 通常離陸と上昇","text_ja":"目的：センターラインを保って加速し、Vr で浮揚、Vy で上昇\nフルパワー（R 長押し）。E（右ラダー）で機首をセンターラインに（プロペラの左偏向）。\n60 kt（Vr）で S を押して機首を約 8° 上げて浮揚。76 kt（Vy）で上昇し、地上 1,000 ft まで（滑走路の方位を保つ）。\n基準：センターライン ±8 m・浮揚 60 ±7 kt・上昇 76 ±10 kt・針路 ±10°"},{"id":"wb-brief-3","room":"brief-3","a":608.5,"c":254.6,"y":1.5,"prompt_ja":"ホワイトボードを見る","title_ja":"予習：n2 推測航法と目的地変更","text_ja":"目的：針路と時間で目標へ飛び、途中の目的地変更で新しい針路・距離・時間を見積もる\n風を読んで針路を決める（風下に流される分だけ風上に向ける）\n時間＝距離 ÷ 対地速度。途中で行き先が変わったら、新しい針路・距離・時間を見積もり直す。"},{"id":"sim-station","room":"sim","a":616.5,"c":268,"y":1.1,"prompt_ja":"訓練装置を使う","title_ja":"訓練装置（FTD 風の練習席）","text_ja":"G1000 型の画面と操縦輪・スロットルの練習席。電源を入れると装置が使えます。\n装置の課目（第 0 段階の地上学科 k1〜k6）は席で受けられます——今日の予定の課目は本番として記録され、それ以外は練習になります。\n飛行練習（フリーフライト）では装置の中で実際に飛べます。交信のチェアフライト（k4）の練習（ステージ 1〜3、記録はされません）もここで。"},{"id":"status-board","room":"lobby","a":646.2,"c":268.5,"y":2.6,"prompt_ja":"今日のフライトを見る","title_ja":"本日のフライト（LAB 飛行場）","text_ja":"08:00  N731SY  Archer  a1 姿勢・出力・トリム  完了\n09:30  N738SY  Archer  t1 → a2 直線水平飛行 → t3  準備中\n10:00  N735SY  Archer  a3 上昇・降下・レベルオフ  準備中\n11:00  N732SY  Archer  t1 通常離陸と上昇  予定\n13:00  N741SY  Archer  t3 通常着陸  予定\n14:30  N452SY  Seminole  m1 双発の離陸と上昇  天候待ち（午後の雷雨）\n16:00  N744SY  Archer  x1 横風着陸  予定"},{"id":"plaque","room":"lobby","a":663.8,"c":259.6,"y":1.7,"prompt_ja":"銘板を読む","title_ja":"翔洋航空 フライトアカデミー","text_ja":"翔洋航空の自社養成パイロットが、基礎訓練（単発機・航法・計器・双発）を受ける訓練所です。\nこのゲームの航空会社・訓練所・人物はすべて架空です。公開情報を基にした非公式のゲームで、実機訓練の代わりにはなりません。"},{"id":"model-seminole","room":"lobby","a":649,"c":252.5,"y":1.2,"prompt_ja":"模型を見る","title_ja":"Piper PA-44-180 Seminole（訓練の双発機）","text_ja":"双発・引き込み脚・T 字尾翼。第 4 段階で片発停止の扱いを学ぶ。\n最小操縦速度 Vmc 56 kt（赤線）、片発での最良上昇率 Vyse 88 kt（青線）。\n（訓練用の目安の値です。実機はその機体の POH に従います）"},{"id":"schedule","room":"dispatch","a":675.8,"c":257.5,"y":1.5,"prompt_ja":"予定表を見る","title_ja":"本日の割り当て（運航管理）","text_ja":"08:00 N731SY a1 姿勢・出力・トリム\n09:30 N738SY t1 → a2 直線水平飛行 → t3\n10:00 N735SY a3 上昇・降下・レベルオフ\n11:00 N732SY t1 通常離陸と上昇\n13:00 N741SY t3 通常着陸\n※ 14:30 以降は雷雨の予報：運航管理と相談して判断"},{"id":"metar","room":"dispatch","a":675.8,"c":252.6,"y":1.6,"prompt_ja":"気象を見る","title_ja":"気象（KLAB は架空の飛行場）","text_ja":"METAR KLAB 121253Z 36005KT 10SM FEW035 SCT250 15/08 A2992\nTAF KLAB 121130Z 1212/1312 36005KT P6SM FEW035\n  TEMPO 1219/1222 4SM TSRA BKN030CB\n読み方：風 360°（真方位）5 kt、視程 10 SM、3,500 ft に少しの雲。気温 15℃・露点 8℃、高度計 29.92。\n午後 3〜6 時（現地時刻。EDT＝Z−4 なので 19〜22Z）は一時的に雷雨。\nATIS は磁方位で伝えるので、風は「010 at 5」と聞こえます。"},{"id":"counter","room":"dispatch","a":670,"c":257.4,"y":1.1,"prompt_ja":"カウンターで尋ねる","title_ja":"運航管理のカウンター","text_ja":"飛ぶ前にここで、機体の割り当て・燃料・天気を確かめ、機体の書類と鍵を受け取る。"},{"id":"headsets","room":"pilot","a":676.4,"c":258,"y":1.4,"prompt_ja":"ヘッドセットを見る","title_ja":"ヘッドセット","text_ja":"機内はエンジン音が大きいので、教官・管制との会話はすべてヘッドセットで。\n使う前に：マイクの位置（口元から 1 cm ほど）、音量、ケーブルの差し込みを確認。"},{"id":"kneeboard","room":"pilot","a":676.4,"c":254.6,"y":1.2,"prompt_ja":"ニーボードを見る","title_ja":"ニーボード","text_ja":"膝に付ける小さな板。ATIS・管制の指示・周波数・時間をここに書き留める。\n今日は：ATIS の記号と高度計、タキシーの指示、離陸の時刻、気づいたこと。"},{"id":"map","room":"pilot","a":683.6,"c":260.8,"y":1.6,"prompt_ja":"地図を見る","title_ja":"LAB 訓練空域図（架空・NOT FOR NAVIGATION）","text_ja":"LAB 飛行場（滑走路 36/18）、LAB VOR、訓練点 LAB-A〜F（色の塔が目印）、湖。\n空中操作の課目は訓練空域（飛行場の北東）で行います。"},{"id":"imsafe","room":"pilot","a":687.8,"c":251.2,"y":1.5,"prompt_ja":"ポスターを読む","title_ja":"IMSAFE：飛ぶ前の自分の点検","text_ja":"I 病気（Illness）\nM 薬（Medication）\nS ストレス（Stress）\nA アルコール（Alcohol）\nF 疲労（Fatigue）\nE 食事・水分（Eating）\nひとつでも不安があれば、教官に言って飛ばない判断を。"},{"id":"notices","room":"lounge","a":688.2,"c":257,"y":1.5,"prompt_ja":"掲示板を見る","title_ja":"訓練生のお知らせ","text_ja":"第 1 段階の学科試験：来週月曜 9:00（計画室）\n午後は雷雨が多い季節。飛行は午前中心に組んでいます\n英語交信の自主練：毎晩 19:00 訓練装置室\nヘッドセットは使ったら元の場所へ\n冷蔵庫の中身には名前を！"},{"id":"coffee","room":"lounge","a":701.1,"c":258.2,"y":1.2,"prompt_ja":"コーヒーを見る","title_ja":"コーヒーマシン","text_ja":"訓練生の燃料。\nただし飛ぶ前の飲みすぎは禁物：カフェインの取りすぎは手の震えと脱水のもと（IMSAFE の E）。"},{"id":"vending","room":"lounge","a":701.15,"c":254.9,"y":1.2,"prompt_ja":"自販機を使う","title_ja":"自動販売機","text_ja":"スポーツドリンクと水、ようかん。ボタンが光って、ガシャンと落ちる音。\n訓練の合間の補給は IMSAFE の E（食事・水分）。"},{"id":"fridge-note","room":"lounge","a":701.25,"c":256.6,"y":1.2,"prompt_ja":"冷蔵庫を開ける","title_ja":"冷蔵庫","text_ja":"名前の書かれたタッパーと、誰かのプリン（名前なし——週末に整理される運命）。\n自分の分には名前を書くこと。"},{"id":"shelf-lounge","room":"lounge","a":688.3,"c":252,"y":1.5,"prompt_ja":"本棚を使う（教科書）","title_ja":"ラウンジの本棚","text_ja":"教科書と先輩の置いていった参考書。E で今日の一節が開きます。"},{"id":"shelf-planning","room":"planning","a":682.3,"c":275.6,"y":1.5,"prompt_ja":"本棚を使う（教科書）","title_ja":"計画室の本棚","text_ja":"航法の資料と教科書。E で今日の一節が開きます。"},{"id":"shelf-brief-1","room":"brief-1","a":645.8,"c":257.6,"y":1.5,"prompt_ja":"本棚を使う（教科書）","title_ja":"ブリーフィング室の本棚","text_ja":"マニュアルの棚。E で今日の一節が開きます。"},{"id":"locker-pilot","room":"pilot","a":687.7,"c":256.4,"y":1.4,"prompt_ja":"ロッカーを使う","title_ja":"ロッカー","text_ja":"飛ぶ日の流れ：ここでヘッドセットとニーボードを受け取り、パイロットルームの地図で計画してから、運航管理で機体の鍵と書類を受け取る。\nヘッドセットはマイクの位置（口元から 1 cm）と音量を確認。使ったら元の場所へ。"},{"id":"pc-reception","room":"lobby","a":660.5,"c":270.5,"y":1.5,"prompt_ja":"受付のモニタを見る","title_ja":"受付のモニタ（航空日誌・天気）","text_ja":"受付のモニタには、今日のフライトと天気、自分の航空日誌が出ます（E で開く）。"},{"id":"pc-dispatch","room":"dispatch","a":667,"c":251.4,"y":1.5,"prompt_ja":"机の PC を見る","title_ja":"運航管理の PC（航空日誌・天気）","text_ja":"運航管理の PC には、今日の天気と自分の航空日誌が出ます（E で開く）。"},{"id":"wb-class2","room":"class2","a":608.5,"c":254.6,"y":5.72,"prompt_ja":"ホワイトボードを見る","title_ja":"大教室：今週の講義","text_ja":"月：航空法規のまとめ\n水：気象（前線と雷雨）\n金：章の節目の講義と質疑\n大人数の座学はここ。窓の外は駐機場——飛行機が気になって集中できない、という声もある。"},{"id":"shelf-library","room":"library","a":611,"c":277.2,"y":5.7,"prompt_ja":"本棚を使う（教科書）","title_ja":"図書・自習室の本棚","text_ja":"教科書の全巻と、法規・気象・運航の資料。E で今日の一節が開きます。\n貸出はノートに記名してから。"},{"id":"lib-map","room":"library","a":629.9,"c":270.6,"y":5.82,"prompt_ja":"地図を見る","title_ja":"LAB 訓練空域図（架空・NOT FOR NAVIGATION）","text_ja":"LAB 飛行場（滑走路 36/18）、LAB VOR、訓練点 LAB-A〜F（色の塔が目印）、湖。\n自習の航法計画はこの図で。"},{"id":"av-screen","room":"av","a":636.9,"c":270.6,"y":5.82,"prompt_ja":"視聴覚スクリーンを見る","title_ja":"教材・視聴覚室","text_ja":"交信の録音と気象の映像教材の部屋。ヘッドセットは壁のラックから。\n実際に声を出す練習は、1 階の訓練装置室の席で（チェアフライトの練習）。"},{"id":"roof-view","room":"roof","a":620,"c":250.5,"y":9.92,"prompt_ja":"場周を眺める","title_ja":"屋上からの場周","text_ja":"滑走路 36/18 と場周、駐機場、訓練空域の方角。\n風の向きと雲の動きを、飛ぶ前に目で確かめる習慣を。\n（この場所は架空です。実在の建物の屋上とは関係ありません）"},{"id":"crm","room":"corridor-n","a":692,"c":263.4,"y":1.5,"prompt_ja":"ポスターを読む","title_ja":"TEM：脅威とエラーを管理する","text_ja":"出発前に「今日の脅威」を言葉にする：突風、混雑した場周、自分の疲れ…\n気づいたら声に出す。分からなければ聞き返す。\n（第 5 段階：CRM・TEM で詳しく）"}],"start":{"room":"brief-1","a":642.2,"c":254.6,"yawToward":{"a":633.6,"c":254.6}},"route":[{"a":643.1,"c":259.5,"note":"ブリーフィング室 1 の扉の前"},{"a":643.1,"c":262.3,"note":"南の廊下"},{"a":649,"c":262.3,"note":"ロビーへ"},{"a":655,"c":253,"note":"エプロンへの自動ドアの前"},{"a":655,"c":244,"note":"外（ひさしの下）"},{"a":641,"c":222,"note":"駐機場"},{"a":641.5,"c":214,"note":"尾翼の横（近づきすぎない）"},{"a":638.8,"c":209.3,"note":"今日の Archer（N738SY）の右の翼の後ろ：乗り込む側"}],"target":{"a":636.5,"c":207.6,"note":"今日の機体"}}